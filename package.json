{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "generate-routes": "tsr generate",
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "format": "oxfmt --check src",
    "format:fix": "oxfmt --write src",
    "check": "oxlint --type-aware src && oxfmt --check src",
    "check:fix": "oxlint --type-aware --fix src && oxfmt --write src",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "test": "vitest --run",
    "knip": "knip",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "clsx": "2.1.1",
    "next-themes": "0.4.6",
    "opentype.js": "2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.6",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/router-cli": "1.167.17",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.0.2",
    "knip": "6.5.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.46.0",
    "oxlint": "1.42.0",
    "oxlint-tsgolint": "0.24.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.3.6",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
